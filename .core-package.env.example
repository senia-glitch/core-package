# ============================================================
# Конфигурация core-package
# ============================================================

# --- Безопасность ---
# Секрет для JWT (обязательно измените в production!)
CORE_JWT_SECRET=change-me-in-production

# Время жизни access-токена (минуты)
CORE_ACCESS_TOKEN_MINUTES=15

# Время жизни refresh-токена (дни)
CORE_REFRESH_TOKEN_DAYS=30

# Количество раундов bcrypt (от 4 до 31, рекомендуем 12)
CORE_BCRYPT_ROUNDS=12

# --- Безопасность (production) ---
# Режим окружения. В production включает проверку JWT-секрета.
# CORE_ENV=production

# --- Конфигурация ---
# Пропустить загрузку .core-package.env (true/1/yes)
# CORE_SKIP_DOTENV=true

# --- Логирование и метрики ---
# Включить сбор метрик (true/false)
CORE_METRICS_ENABLED=true

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
CORE_LOG_LEVEL=INFO

# Путь к файлу лога (если не указан, вывод в stdout)
# CORE_LOG_FILE=./logs/core.log